{
  "defaults": {
    "client_log": "/app/client_e2e.log",
    "timeout_sec": 120
  },
  "groups": [
    {
      "name": "sequential_rotating",
      "initial_delay_sec": 0,
      "periodicity": 2,
      "repetitions": 2,
      "send": {
        "mode": "sequential",
        "payload_files": ["1-route.json", "1-route.json"]
      }
    },
    {
      "name": "parallel_burst",
      "initial_delay_sec": 1,
      "periodicity": 0,
      "repetitions": 1,
      "send": {
        "mode": "parallel",
        "payload_files": ["1-route.json", "1-route.json"]
      }
    }
  ]
}
