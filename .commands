# docker-compose
# docker


# ls #
docker images

# build #
docker build -t "cpp" .
# docker buildx build --progress=plain -t cpp . --load

# run #
docker run cpp

# --rm -it     # rm      interactive

# docker run -v cpp-build:/app/build cpp   # wolumen zapsujący app/build
# docker run -v "$(pwd)/build:/app/build" cpp

# Sam build (bez OTLP do hosta): 127.0.0.1 w kontenerze ≠ host z netcat.
# docker run --rm -it -v "$(pwd)/build-docker:/app/build" cpp

# OTLP do netcat na hoście (Terminal A: ./listen_otlp_http.sh z cpp/).
# Linux/WSL: --add-host=host.docker.internal:host-gateway
# Docker Desktop: często host.docker.internal już jest — możesz pominąć --add-host.
docker run --rm -it \
  --add-host=host.docker.internal:host-gateway \
  -e OTEL_DEMO_TRACE_EXPORT=otlp \
  -e OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces \
  -v "$(pwd)/build-docker:/app/build" \
  cpp


# uruchomienie kontenera w trybie interaktywnym #
# docker run -it cpp

# wejście do kontenera #
# docker run -it --rm cpp bash




# Image pull #

docker pull python:3.10-slim
docker pull otel/opentelemetry-collector-contrib:latest

# — Stack z docker-compose: Jaeger, OTel Collector, Prometheus, Grafana + klienci
# docker compose up -d --build
#   Jaeger:      http://localhost:16686     (trace’y, UI własne)
#   Prometheus:  http://localhost:9090     (metryki: scrape collectora, nie Jaegera)
#   Grafana:     http://localhost:3000     (admin / admin) — datasources: Prometheus + Jaeger
# Walidacja compose (nie uruchamia kontenerów):
#   docker compose config
# Opcjonalne atrybuty resource na trace’ach (klienci — Python/Rust/C#/C++):
#   OTEL_SERVICE_INSTANCE_ID
#   OTEL_ENVIRONMENT / DEPLOYMENT_ENVIRONMENT
#   OTEL_DEMO_RESOURCE_TAG  (→ demo.instance.tag w backendzie)
#
# Inspekcja trace w Jaegerze po API (czy są spany worker_nodejs itd.):
#   cd UMISI-sem1-OpenTelemetry && chmod +x scripts/jaeger_inspect_trace.sh
#   ./scripts/jaeger_inspect_trace.sh 318482eed3b2f14612ae26c743e7ec05
#   JAEGER_URL=http://127.0.0.1:16686 ./scripts/jaeger_inspect_trace.sh <trace_id_hex> worker_nodejs
# Lista serwisów w Jaegerze (czy w ogóle jest worker_nodejs):
#   chmod +x scripts/jaeger_list_services.sh && ./scripts/jaeger_list_services.sh
